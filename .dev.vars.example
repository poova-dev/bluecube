# Cloudflare Pages local development environment variables (.dev.vars)
# Copy this file to .dev.vars for local testing with `wrangler pages dev`.
# DO NOT commit .dev.vars to version control.

# Cloudinary Configuration
# Plain variable:
CLOUDINARY_CLOUD_NAME=jvdlk3j0
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
# Secret (Required for /api/cloudinary-sign):
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Firebase Configuration
# Plain variable:
FIREBASE_PROJECT_ID=bluecube-studio
FIREBASE_API_KEY=your_firebase_web_api_key_here
# Secret (Required for server-side Firestore RS256 token minting in Pages Functions):
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Deploy Hook (Cloudflare Pages Production Build Trigger)
# Secret:
DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/your_hook_id_here

# Resend Email Integration
# Secret:
RESEND_API_KEY=re_your_resend_api_key_here
# Plain variable:
CONTACT_TO=design@bluecube.co.in
RESEND_FROM=Blue Cube Architects <onboarding@resend.dev>

# Cloudflare Turnstile CAPTCHA Protection
# Plain variable (Public site key used in frontend HTML data-sitekey):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx_your_site_key
# Secret (Server-side secret key used in /api/contact verification):
# Test keys provided by Cloudflare:
# Sitekey: 1x00000000000000000000AA (Always passes)
# Secret key: 1x0000000000000000000000000000000AA (Always passes)
# Sitekey: 2x00000000000000000000AB (Always fails)
# Secret key: 2x0000000000000000000000000000000AB (Always fails)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
